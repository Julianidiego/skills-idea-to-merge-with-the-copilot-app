<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<div id="search-field" class="field" hidden>
  <label for="bookmark-search">Search bookmarks</label>
  <input
    id="bookmark-search"
    type="search"
    autocomplete="off"
    placeholder="Search by URL or slug"
  />
</div>

<div class="bookmark-actions">
  <button id="export-json" type="button" class="clear">Export JSON</button>
  <label for="import-json" class="clear file-button">Import JSON</label>
  <input id="import-json" type="file" accept="application/json,.json" hidden />
</div>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>
<p id="no-results" class="empty" hidden>No bookmarks match your search.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <div class="list-actions">
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>
</div>
<p id="import-status" class="hint" hidden></p>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    generateSlug,
    exportBookmarksToJSON,
    filterBookmarks,
    importBookmarksFromJSON,
    normalizeUrl,
    parseStoredBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const noResults = document.getElementById('no-results');
  const searchField = document.getElementById('search-field');
  const searchInput = document.getElementById('bookmark-search');
  const listHeader = document.getElementById('list-header');
  const exportJson = document.getElementById('export-json');
  const importJson = document.getElementById('import-json');
  const importStatus = document.getElementById('import-status');
  const clearAll = document.getElementById('clear-all');
  let bookmarks: Bookmark[] = [];
  let searchQuery = '';

  function saveBookmarks() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Storage may be unavailable or full; the in-memory list remains usable.
    }
  }

  function setImportStatus(message: string) {
    if (!importStatus) return;
    importStatus.textContent = message;
    importStatus.hidden = !message;
  }

  function renderBookmarks() {
    if (!list || !emptyState || !noResults || !searchField || !listHeader) return;

    const visibleBookmarks = filterBookmarks(bookmarks, searchQuery);
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    noResults.hidden = bookmarks.length === 0 || visibleBookmarks.length > 0;
    searchField.hidden = bookmarks.length === 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of visibleBookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => {
            copy.textContent = 'Copy';
          }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
        }
      });

      item.append(link, separator, slug, copy);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(input instanceof HTMLInputElement)) return;

    try {
      const url = normalizeUrl(input.value);
      const slug = generateSlug(bookmarks.map((bookmark) => bookmark.slug));
      bookmarks = [...bookmarks, { url, slug }];
      saveBookmarks();
      input.value = '';
      renderBookmarks();
    } catch {
      input.setCustomValidity('Enter a valid HTTP or HTTPS URL.');
      input.reportValidity();
      input.addEventListener('input', () => input.setCustomValidity(''), { once: true });
    }
  });

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value;
    renderBookmarks();
  });

  exportJson?.addEventListener('click', () => {
    const blob = new Blob([exportBookmarksToJSON(bookmarks)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'mona-bookmarks.json';
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 0);
  });

  importJson?.addEventListener('change', async () => {
    if (!(importJson instanceof HTMLInputElement) || !importJson.files?.[0]) return;

    try {
      const importedBookmarks = importBookmarksFromJSON(await importJson.files[0].text());
      const existingUrls = new Set(bookmarks.map((bookmark) => bookmark.url));
      const existingSlugs = new Set(bookmarks.map((bookmark) => bookmark.slug));
      const newBookmarks = importedBookmarks.filter((bookmark) => {
        if (existingUrls.has(bookmark.url) || existingSlugs.has(bookmark.slug)) {
          return false;
        }
        existingUrls.add(bookmark.url);
        existingSlugs.add(bookmark.slug);
        return true;
      });

      bookmarks = [...bookmarks, ...newBookmarks];
      saveBookmarks();
      renderBookmarks();
      setImportStatus(
        newBookmarks.length > 0
          ? `Imported ${newBookmarks.length} bookmark${newBookmarks.length === 1 ? '' : 's'}.`
          : 'No new valid bookmarks found in that file.',
      );
    } catch {
      setImportStatus('Unable to read the selected JSON file.');
    } finally {
      importJson.value = '';
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // The visible list still clears if storage is unavailable.
    }
    renderBookmarks();
  });

  try {
    bookmarks = parseStoredBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch {
    bookmarks = [];
  }
  renderBookmarks();
</script>
